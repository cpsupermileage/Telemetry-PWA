{
	"name": "telemetry-pwa",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "tsc && vite build && wrangler deploy --dry-run",
		"preview": "vite preview",
		"lint": "eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate --config=drizzle-trips.config.ts && drizzle-kit generate --config=drizzle-telemetry.config.ts",
		"generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/logo.svg",
		"prepare": "husky"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.25.0",
		"@eslint/js": "^9.39.2",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24.10.7",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.3",
		"@types/web-bluetooth": "^0.0.21",
		"@vis.gl/react-google-maps": "^1.7.1",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vitejs/plugin-react": "^5.1.2",
		"babel-plugin-react-compiler": "19.1.0-rc.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.19",
		"drizzle-kit": "^0.31.9",
		"drizzle-orm": "^0.45.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-compiler": "19.1.0-rc.2",
		"eslint-plugin-react-dom": "^2.5.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.26",
		"eslint-plugin-react-x": "^2.5.5",
		"eventemitter3": "^5.0.1",
		"globals": "^16.5.0",
		"hono": "^4.11.9",
		"husky": "^9.1.7",
		"idb": "^8.0.3",
		"lint-staged": "^16.2.7",
		"lucide-react": "^0.545.0",
		"next-themes": "^0.4.6",
		"prettier": "^3.7.4",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-router": "^7.12.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.52.0",
		"vite": "npm:rolldown-vite@7.1.14",
		"vite-plugin-pwa": "^1.2.0",
		"wrangler": "^4.65.0",
		"zod": "^4.3.6"
	},
	"pnpm": {
		"overrides": {
			"vite": "npm:rolldown-vite@7.1.14"
		}
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx}": "eslint --cache --fix",
		"*.{js,ts,jsx,tsx,css,md,json}": "prettier --write"
	},
	"engines": {
		"node": "24.13.0"
	}
}
